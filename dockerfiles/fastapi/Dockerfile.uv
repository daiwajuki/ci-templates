# syntax=docker/dockerfile:1.7
#
# @daiwajuki/ci-templates - FastAPI Production Dockerfile (uv)
# Stack:    FastAPI + Python 3.12+ (uv 管理)
# Base:     python:3.12-slim
# Manager:  uv (https://github.com/astral-sh/uv)
# Port:     8080 (Cloud Run convention)
# User:     non-root (app:app, uid/gid 1001)

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    TZ=Asia/Tokyo

# uv バイナリを astral-sh の公式イメージから取得（pip install uv より高速）
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# CUSTOMIZE: build 時に必要な OS パッケージ（C 拡張ビルド等）
# RUN apt-get update && apt-get install -y --no-install-recommends \
#       build-essential \
#  && rm -rf /var/lib/apt/lists/*

# 依存関係のキャッシュ可能なインストール
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev --no-install-project

# CUSTOMIZE: アプリケーションコードの場所（src/ や server/ の場合は調整）
COPY app/ app/

# CUSTOMIZE: 静的アセット等を含める場合
# COPY assets/ assets/

# CUSTOMIZE: 実行時に必要な OS パッケージ（フォント等）
# RUN apt-get update && apt-get install -y --no-install-recommends \
#       fonts-noto-cjk \
#  && rm -rf /var/lib/apt/lists/*

# 非 root ユーザー
RUN groupadd --system --gid 1001 app && \
    useradd --system --uid 1001 --gid app --shell /sbin/nologin app && \
    chown -R app:app /app

USER app

# CUSTOMIZE: health endpoint パスがアプリ側と一致しているか確認
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health').read()" || exit 1

ENV PORT=8080
EXPOSE 8080

CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
